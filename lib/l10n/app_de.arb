  "helpShortDescription": "Musiksammlungs-Manager für Linux und Android",
  "@helpShortDescription": { "description": "Help: Short description" },
  "helpSectionDescription": "BESCHREIBUNG",
  "@helpSectionDescription": { "description": "Help section title" },
  "helpDescriptionBody": "MusicUp verwaltet deine Musiksammlung auf Linux und Android. Alben lassen sich manuell anlegen, aus Ordnerstrukturen importieren oder über die Discogs-Datenbank suchen und hinzufügen.",
  "@helpDescriptionBody": { "description": "Help section body" },
  "helpSectionCollection": "SAMMLUNG VERWALTEN",
  "@helpSectionCollection": { "description": "Help section title" },
  "helpCollectionBody": "Alben anlegen mit Name, Künstler, Genre, Jahr, Medium und Tracks.\nBestehende Alben bearbeiten und Detailansicht nutzen.\nDuplikaterkennung beim Import und manuellen Anlegen.\nErweiterte Suche und Filter nach Medium, Genre, Jahr.\nSortierung nach verschiedenen Kriterien.\nSammlung als PDF exportieren (sortiert nach Künstler).",
  "@helpCollectionBody": { "description": "Help section body" },
  "helpSectionDiscogs": "DISCOGS INTEGRATION",
  "@helpSectionDiscogs": { "description": "Help section title" },
  "helpDiscogsBody": "OAuth 1.0a Authentifizierung in den Einstellungen einrichten.\nAlben in der Discogs-Datenbank suchen und mit Metadaten importieren.\nKomplette Discogs-Sammlung synchronisieren.\nAutomatisches API-Rate-Limiting.",
  "@helpDiscogsBody": { "description": "Help section body" },
  "helpSectionImportExport": "IMPORT/EXPORT",
  "@helpSectionImportExport": { "description": "Help section title" },
  "helpImportExportBody": "JSON (empfohlen): Vollständige Daten mit Tracks und Metadaten.\nCSV: Tabellenkompatibel, mit optionaler Track-Unterstützung.\nXML: Strukturiertes Format für Datenaustausch.\nOrdner-Import: Automatische Erkennung aus Musikordnern (Format: \"01 - Tracktitel.mp3\").",
  "@helpImportExportBody": { "description": "Help section body" },
  "helpSectionWantlist": "WANTLIST",
  "@helpSectionWantlist": { "description": "Help section title" },
  "helpWantlistBody": "Eigener Bildschirm für gewünschte Alben.\nOnline/Offline-Synchronisation mit Discogs.\nAlben von der Wantlist in die Sammlung übernehmen.\nIntelligente Konflikterkennung beim Synchronisieren.\nWunschliste als PDF exportieren.",
  "@helpWantlistBody": { "description": "Help section body" },
  "helpSectionFilePaths": "DATEIPFADE",
  "@helpSectionFilePaths": { "description": "Help section title" },
  "helpFilePathsBody": "Konfiguration:   ~/.config/music_up/\nSammlung:        Konfigurierbar in Einstellungen\nWantlist:        Konfigurierbar in Einstellungen\nLogs:            Siehe Einstellungen > Logs senden",
  "@helpFilePathsBody": { "description": "Help section body" },
  "helpSectionOptions": "OPTIONEN",
  "@helpSectionOptions": { "description": "Help section title" },
  "helpOptionsBody": "-h, --help       Hilfe anzeigen und beenden\n-v, --version    Version anzeigen und beenden",
  "@helpOptionsBody": { "description": "Help section body" },
  "helpSectionAuthor": "AUTOR",
  "@helpSectionAuthor": { "description": "Help section title" },
  "helpSectionBugReport": "FEHLER MELDEN",
  "@helpSectionBugReport": { "description": "Help section title" },
  "helpBugReportBody": "Fehler und Verbesserungsvorschläge per E-Mail an:\nnobo_code@posteo.de\n\nQuellcode: https://github.com/hiphopconnect/musicup",
  "@helpBugReportBody": { "description": "Help section body" }
}
